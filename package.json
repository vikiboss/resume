{
  "name": "resume",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run dev:local",
    "dev:online": "DATA_ENV=online vite --configLoader native",
    "dev:local": "DATA_ENV=local vite --configLoader native",
    "build": "tsc -b && vite --configLoader native build",
    "lint": "oxlint",
    "preview": "vite --configLoader native preview",
    "format": "prettier --write ."
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/devtools": "^0.7.6",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-restart": "^2.0.0"
  }
}
